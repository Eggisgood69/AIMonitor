{
  "manifest_version": 3,
  "name": "AIMonitor 網頁偵測",
  "version": "1.0.5",
  "description": "讓 AIMonitor 在 Gemini / Claude / ChatGPT 網頁切到背景分頁時也偵測得到生成狀態。只看停止 / 允許按鈕，不讀對話內容，只送到本機的 AIMonitor。",
  "permissions": ["scripting", "alarms", "storage"],
  "host_permissions": [
    "https://claude.ai/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://gemini.google.com/*",
    "http://127.0.0.1:47322/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*", "https://chatgpt.com/*", "https://chat.openai.com/*", "https://gemini.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": { "128": "icon128.png" }
}
